# Google OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Opcional: após o primeiro login da admin o refresh token fica salvo na tabela "admins"
GOOGLE_REFRESH_TOKEN=
# Opcional: id de uma agenda específica (padrão: agenda principal)
GOOGLE_CALENDAR_ID=primary

# Supabase (use a service_role key apenas no backend)
SUPABASE_URL=
SUPABASE_KEY=

# JWT (gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=

# Admin (somente este e-mail Google entra no painel)
ADMIN_EMAIL=

# Frontend
FRONTEND_URL=http://localhost:5173
TIMEZONE=America/Sao_Paulo
